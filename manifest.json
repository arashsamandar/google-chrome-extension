{
  "manifest_version": 3,
  "name": "Alt Arrow Tab Switcher",
  "version": "1.0",
  "background": { "service_worker": "background.js" },
  "commands": {
    "next-tab": {
      "suggested_key": { "default": "Alt+Right" },
      "description": "Switch to next tab"
    },
    "prev-tab": {
      "suggested_key": { "default": "Alt+Left" },
      "description": "Switch to previous tab"
    }
  }
}
